# --- Database (Drizzle + PostgreSQL, used by /api/health) ---
# Optional. Example format: postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL=

# --- LLM provider (server-only secrets; never prefix with NEXT_PUBLIC_) ---
# "openai", "anthropic", or "google" (Gemini free-tier keys work with Google)
LLM_PROVIDER=google
# Optional. Defaults: openai -> gpt-4.1-mini, anthropic -> claude-sonnet-4-5,
# google -> gemini-2.5-flash
LLM_MODEL=gemini-2.5-flash
# Required. API key for the provider above.
# For Google/Gemini you can also set GEMINI_API_KEY or GOOGLE_GENERATIVE_AI_API_KEY.
LLM_API_KEY=
GEMINI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# --- Rate limiting ---
# Requests per IP per minute on /api/review (default 10).
RATE_LIMIT_PER_MINUTE=10
# Optional. If unset, an in-memory limiter is used (per instance; fine for local dev).
# Set both on Vercel for a limit shared across serverless instances.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- CORS ---
# Comma-separated extra origins allowed to call /api/review.
# Same-origin requests are always allowed.
ALLOWED_ORIGINS=
